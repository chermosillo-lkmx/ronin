{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "desktop/dist",
    "rootDir": "desktop"
  },
  "include": ["desktop/main/**/*.ts", "desktop/preload/**/*.ts"],
  "exclude": ["desktop/**/*.test.ts"]
}
